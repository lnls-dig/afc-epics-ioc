record(ao, "$(P)$(R)PosXOffset-SP") {
    field(EGU, "nm")
    field(PINI, "YES")
}

record(ai, "$(P)$(R)PosXOffset-RB") {
    field(EGU, "nm")
    field(INP, "$(P)$(R)PosXOffset-SP CP")
}

record(ao, "$(P)$(R)PosYOffset-SP") {
    field(EGU, "nm")
    field(PINI, "YES")
}

record(ai, "$(P)$(R)PosYOffset-RB") {
    field(EGU, "nm")
    field(INP, "$(P)$(R)PosYOffset-SP CP")
}

record(ao, "$(P)$(R)PosKx-SP") {
    field(EGU, "nm")
    field(PINI, "YES")
}

record(ai, "$(P)$(R)PosKx-RB") {
    field(EGU, "nm")
    field(INP, "$(P)$(R)PosKx-SP CP")
}

record(ao, "$(P)$(R)PosKy-SP") {
    field(EGU, "nm")
    field(PINI, "YES")
}

record(ai, "$(P)$(R)PosKy-RB") {
    field(EGU, "nm")
    field(INP, "$(P)$(R)PosKy-SP CP")
}

record(aao, "$(P)$(R)SupMat-SP") {
    field(NELM, "16")
    field(FTVL, "DOUBLE")
    field(PINI, YES)
}

record(aai, "$(P)$(R)SupMat-RB") {
    field(INP, "$(P)$(R)SupMat-SP CP")
    field(NELM, "16")
    field(FTVL, "DOUBLE")
}

record(aai, "$(P)$(R)TableLabels-Cte"){
    field(FTVL, STRING)
    field(NELM, 8)
    field(INP, {const: [
        "Amplitude A",
        "Amplitude B",
        "Amplitude C",
        "Amplitude D",
        "Position X",
        "Position Y"
    ]})
    info(Q:group, {
        "$(P)$(R)Monit-Mon": {
            labels: {+type: "plain", +channel: "VAL"},
            descriptor: {+type: "const", +const: "monit-rate data"}
        },
        "$(P)$(R)GENData-Mon": {
            +id: "epics:nt/NTTable:1.0",
            labels: {+type: "plain", +channel: "VAL"},
            descriptor: {+type: "const", +const: "general acquisition core data"}
        },
        "$(P)$(R)PMData-Mon": {
            +id: "epics:nt/NTTable:1.0",
            labels: {+type: "plain", +channel: "VAL"},
            descriptor: {+type: "const", +const: "post-mortem acquisition core data"}
        },
    })
}

record("*", "$(P)$(R)AmpFIFOCalc") {
    field(SNAM, "asub_pbpm_pos_calc")
    field(INPE, "$(P)$(R)PosXOffset-RB")
    field(FTE, "DOUBLE")
    field(INPF, "$(P)$(R)PosKx-RB")
    field(FTF, "DOUBLE")
    field(INPG, "$(P)$(R)PosYOffset-RB")
    field(FTG, "DOUBLE")
    field(INPH, "$(P)$(R)PosKy-RB")
    field(FTH, "DOUBLE")
    field(INPI, "$(P)$(R)SupMat-RB")
    field(FTI, "DOUBLE")
    field(NOI, "16")
    field(OUTA, "$(P)$(R)PosX-Mon PP")
    field(FTVA, "DOUBLE")
    field(OUTB, "$(P)$(R)PosY-Mon PP")
    field(FTVB, "DOUBLE")
}

record(ai,"$(P)$(R)PosX-Mon"){
    field(DESC,"Monitoring Position X")
    field(EGU, "nm")
    field(MDEL, -1)
    info(Q:group, {
        "$(P)$(R)Monit-Mon": {
            "value.X": {+type: "plain", +channel: "VAL"}
        }
    })
}

record(ai,"$(P)$(R)PosY-Mon"){
    field(DESC,"Monitoring Position Y")
    field(EGU, "nm")
    field(MDEL, -1)
    info(Q:group, {
        "$(P)$(R)Monit-Mon": {
            "value.Y": {+type: "plain", +channel: "VAL", +trigger: "*"}
        }
    })
}
